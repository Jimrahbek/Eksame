---
import Layout from "../../layout/layout.astro";
import Ydelser from "../ydelser.astro";

export async function getStaticPaths() {
  
  const res = await fetch(`${import.meta.env.SUPABASE_URL}/rest/v1/Anne_Louise_Hjort?select=*`, {
    headers: {
      apikey: import.meta.env.SUPABASE_PUBLISHABLE_KEY
    }
  });

  const data = await res.json();

  return data.map((ydelser: any) => ({
    params: { id: ydelser.id.toString() },
    props: { ydelser }
  }));
}

const { ydelser } = Astro.props;
---

<Layout>
  <Ydelser ydelser={ydelser} />
</Layout>