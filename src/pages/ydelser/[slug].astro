---
import Layout from "../../layout/layout.astro";
import YdelserDetails from "../../components/ydelser_details.astro";
import YdelseInfo from "../../components/ydelser-info.astro";
import YdelseBook from "../../components/ydelser-book.astro";


type Ydelser = {
  id: number;
  slug: string;
  tid: number;
  titel: string;
  metode: string;
  pris: number;
  info: string;
  show_price: boolean;
  alttext: string;

};

export async function getStaticPaths() {
  const res = await fetch(`${import.meta.env.PUBLIC_SUPABASE_URL}/rest/v1/anne-louise-hjort?select=*`, {
    headers: {
      apikey: import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY,
    },
  });

  

  const data: Ydelser[] = await res.json();

  return data.map((ydelse: Ydelser) => ({
    params: { slug: ydelse.slug },
    props: { ydelse },
  }));
}



const { ydelse } = Astro.props;
---

<Layout title={ydelse.titel}>
  <YdelserDetails ydelse={ydelse} />
    <YdelseInfo />
  <YdelseBook />
</Layout>
