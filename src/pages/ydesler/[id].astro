---
import Layout from "../../layout/layout.astro";
import Ydelser from "../../components/ydelser_details.astro";

export async function getStaticPaths() {
  
  const res = await fetch(`${import.meta.env.SUPABASE_URL}/rest/v1/Anne_Louise_Hjort?select=*`, {
    headers: {
      apikey: import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY,
      Authorization: `Bearer ${import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY}`,
    },
  });

  const data = await res.json();

  return data.map((ydelse: any) => ({
    params: { id: ydelse.id.toString() },
    props: { ydelse }
  }));
}

const { ydelse } = Astro.props;
---

<Layout>
  <Ydelser ydelse={ydelse} />
</Layout>