---
import Forside_erfaring from "../assets/forside-erfaring.png";
---

<div class="grid_1-1">
  <div class="box_h2">
    <h2>Faglig erfaring og uddannelse</h2>

    <h4 class="h4_pad">Krisepsykolog</h4>
    <h4 class="h4_pad">Autoriseret psykolog</h4>
    <h4 class="h4_pad">
      Specialist i klinisk psykologi samt godkendt supervisor
    </h4>

    <a href="/om_mig">
      <button class="btn">Mere om min erfaring</button>
    </a>
  </div>

  <div class="order">
    <img src={Forside_erfaring.src} alt="Anne sidder i en stol">
  </div>
</div>
</div>
  <style>
.h4_pad {

}

/* Dots */
.h4_pad::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);

  width: 20px;
  height: 20px;
  border-radius: 50%;

background-color: var(--color-CTA);
}

.h4_pad{
    position: relative;
  padding-left: 50px; 
  padding-top: 30px;
  padding-bottom: 60px;
}

  .erfaring,
  .text_witdh {
    color: white;
  }

  .box_h2 {
    border-radius: 5px 5px 5px 50px;
    padding: 18px 28px;
    background-color: var(--color-section_bg);
  }

  .section_bg {
    background-color: var(--color-section_accent);
    padding-bottom: 30px;
    margin-inline: -100px;
  }

  .erfaring {
    padding-top: 40px;
    padding-bottom: 30px;
    text-align: center;
  }

  .text_pad {
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .text_witdh {
    padding-left: 110px;
    padding-right: 110px;
  }

  .grid_1-1 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;

    width: fit-content;
    margin-inline: auto;
  }
</style>
