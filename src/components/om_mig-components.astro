  <style>
.om-mig {
  display: grid;
  grid-template-columns: 450px auto;
  grid-template-rows: 1fr auto;
  max-width: fit-content;
  margin: 0 auto;
  padding-top: 200px;
  padding-bottom: 200px;
}

.billede-og-tekst {
  display: flex;
  flex-direction: column;
  grid-column: 1;
  grid-row: 1;
}

.erfaring-section {
  display: flex;
  flex-direction: column;
  gap: 20px;
  grid-column: 2;
  grid-row: 1 / 3;
}

.knap {
  grid-column: 1;
  grid-row: 2;
  align-self: end;
}

.knap button {
  background-color: brown;
  border: none;
  padding: 10px 60px;
  font-family: inherit;
  cursor: pointer;
  margin-top: 20px;
  border-top-right-radius: 30px;
  border-bottom-left-radius: 30px;
  transition: 0.3s ease;
}

.knap button:hover {
  opacity: 0.9;
}

.billede {
  width: 400px;
  height: auto;
  border-top-left-radius: 30px;
}

.p-tekst {
  line-height: 1.5;
  max-width: 100%;
  white-space: normal;
word-break: normal;
}
.p-tekst {
    width: 400px;
}
.erfaringer {
  background-color: brown;
  padding: 20px;
  max-width: 450px;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 15px;
  transition: all 1.3s ease;
}

.erfaringer:first-child {
  border-top-right-radius: 50px;
}

.erfaringer:last-child {
  border-bottom-right-radius: 50px;
}

.top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.tekst {
  line-height: 1.3;
}

.accordion-content {
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  line-height: 1.5;
  transition: all 0.3s ease;
}

.erfaringer.active .accordion-content {
  max-height: 500px;
  opacity: 1;
}

.cirkel {
  flex-shrink: 0;
}

.cirkel img {
  width: 35px;
  height: 35px;
  object-fit: contain;
  display: block;
  transition: transform 0.3s ease;
}

.erfaringer.active .cirkel img {
  transform: rotate(180deg);
}

@media screen and (max-width: 768px) {
  .om-mig {
    display: flex;
    flex-direction: column;
    gap: 32px;
    width: 100%;
    max-width: 450px;
    margin: 0 auto;
    padding: 80px 16px;
    box-sizing: border-box;
  }

  .billede-og-tekst-og-knap,
  .erfaring-section {
    width: 100%;
  }

  .billede {
    width: 100%;
    max-width: none;
  }

  .p-tekst {
    width: 100%;
    line-height: 1.5;
  }

  .knap button {
    width: 100%;
    padding: 14px 28px;
  }

  .erfaringer {
    width: 100%;
    max-width: none;
    box-sizing: border-box;
  }

  .top {
