  <style>
.padding{
    padding-top: 20px;
}

.adresser,
.psykologhuset,
.nordre {
    background-color: var(--color-section_accent);
    padding: 18px 28px;
    color: #FFFFFF;

    width: 100%;
    max-width: 600px;
    box-sizing: border-box;
}

.adresser {
    border-radius: 50px 5px 5px 5px;
    margin-bottom: 1rem;
}

.psykologhuset {
    border-radius: 5px 50px 5px 5px;
}

.nordre {
    border-radius: 5px 5px 5px 50px;
}

.grid_1-1,
.grid {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    align-items: stretch;
}

.grid_1-1 > div:first-child,
.grid > div:last-child {
    flex: 1.4;
}

.grid_1-1 > div:last-child,
.grid > div:first-child {
    flex: 1;
}

.grid_1-1 img,
.grid img {
    width: 100%;
    height: 100%;
    min-height: 320px;

    object-fit: cover;
    display: block;
}


img {
    width: 100%;
    height: auto;
    display: block;
}

.text_width,
.text_width1,
.h2_pad {
    width: auto;
}

.h2_pad {
    color: #FFFFFF;
}

/* Mobile */
@media (max-width: 900px) {
    .grid_1-1,
    .grid {
        grid-template-columns: 1fr;
    }

    .adresser,
    .psykologhuset,
    .nordre {
        max-width: 100%;
    }
}
 </style>