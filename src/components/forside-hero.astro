---
import Hero from "../assets/forsideHero.png";
---

<div class="velkommen"><h1>Velkommen</h1></div>

<article class="hero_grid">
  <section class="herosektion_text">
    <div class="under_overskirft">
      <h2>Psykolog</h2>
      <h2>Anne Louise Hjort</h2>
    </div>

    <div class="text">
      <p>
        Mit navn er Anne Louise Hjort (hun/hende), og jeg er psykolog, med
        lokaler i Københavsområdet. Som erfaren krisepsykolog ved jeg, hvor
        hjælpsomt det er for mennesker i affekt, at jeg som psykolog kan skabe
        ro i deres nervesystem og tryghed gennem tydelighed og struktur.
      </p>
      <p>
        Med flere uddannelser inden for pædagogik og psykologi er jeg trænet i
        at tale med såvel børn og unge som voksne.
      </p>
    </div>

    <div class="knap">
      <a href="/booking">
        <button class="btn endestation">Kontakt mig her</button></a
      >
    </div>
  </section>

  <div class="hero_img">
    <img
      src={Hero.src}
      alt="Anne Louise smiler venligt og kigger direkte ind i kameraet. Hun har lyst hår, der er sat op i en knold, og hun har på en hvid bluse. Baggrunden er neutral og lys, hvilket fremhæver hendes venlige udstråling."
    />
  </div>
</article>

<style>
  /*****************. overskrift ******************/
  .velkommen {
    text-align: center;
  }

  /*****************  hero sektion ******************/
  .hero_grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    justify-content: center;
    padding-top: 30px;
    padding-left: 30px;
    padding-bottom: 30px;
    margin: 0 auto;
    max-width: 900px;
  }

  /*****************  teskt felt ******************/
  .herosektion_text {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    padding: 0 25px;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  p {
    max-width: 72ch;
  }
  /*****************  billeder ******************/

  .hero_img img {
    height: 100%;
    object-fit: cover;
    border-radius: 5px 50px 5px 5px;
  }

  /*****************  CTA knap ******************/
  .btn {
    padding-inline: 4rem;
  }

  .knap {
    padding: 5rem 5rem 0 0;
    display: contents;
  }

  /*****************  CTA knap  & billed ******************/

  @media (max-width: 768px) {
    .hero_grid {
      display: flex;
      flex-direction: column;
      gap: 25px;
      margin: 0 1rem;
      padding: 0 10px;
      box-sizing: border-box;
      padding: 0 10px;
    }

    .herosektion_text {
      order: 2;
      margin-bottom: 20px;
    }

    /* .hero_grid > div:first-child {
      order: 2;
      width: 100%;
    }

    .hero_grid > div:last-child {
      order: 1;
      width: 100%;
    } */
    .btn {
      width: 100%;
      border-radius: 5px 50px 5px 50px;
      justify-content: center;
    }
    .hero_grid img {
      width: 100%;
      max-width: 320px;
      margin: 0 auto;
      border-radius: 24px;
      display: block;
      border-radius: 5px 50px 5px 5px;
    }
    .hero_img {
      display: flex;
      justify-content: center;
      border-radius: 5px 50px 5px 5px;
    }

    .hero_grid {
      max-width: 400px;
      margin: 0 auto;
    }

    .velkommen {
      text-align: center;
      padding-bottom: 20px;
    }

    h2 {
      text-align: center;
      line-height: 1.2;
    }
  }
</style>
