---
const { ydelse } = Astro.props;
---


  <div class="ydesler-details-titel"><h1>{ydelse.titel} </h1> </div>
        <section class="ydelser-details-section">

          <article class="ydelser-details-article">
           <p>{ydelse.info} </p>
            <p><strong>Metode:</strong> {ydelse.metode}</p>

            <div  class="ydelser-details-pris-wapper">

               <div class="ydelser-details-pris">
          {ydelse.show_price ? (
            <p> <strong>Pris:</strong> {ydelse.tid} minutter pr. session á {ydelse.pris}kr. </p>
            ) : (
            <p> <strong>Pris:</strong> aftales individuelt.</p>
            )}
              </div>
             
              <button class="btn"><a href="src/components/booking.astro"><h4>Gå til booking</h4></a></button>
    
        
            </div>
          </article>

          <div class="ydelser-details-billed"><img src={`/src/assets/ydesler_img/${ydelse.id}.webp`} alt={ydelse.alttext} /></div>
        </section>


<style>

/******************** title *********************/
  .ydesler-details-titel {
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 2rem;
  }
  .ydesler-details-titel h1 {
    font-size: 2.5rem;
    color: var(--color-text);
  }


  /****************** overdordenet - sektion ***************/

  .ydelser-details-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    padding: 2rem;
    align-items: stretch;
  }


  /**************** billed og tekst *************/

.ydelser-details-article,
.ydelser-details-billed {
  min-height: 520px;
}

  /******************* info-box ****************/

  .ydelser-details-article {
    display: flex;
    flex-direction: column;
    align-items: left;
    text-align: left;
    padding: 2rem;
    border-radius: 5px 5px 5px 50px;
    width: 100%;
    height: 100%;
    background-color: var(--color-section_accent);
  }

  .ydelser-details-article p {
    margin-bottom: 1rem;
    color: var(--color-text-light);
  }

  /****************** pris og booking ****************/    
  .ydelser-details-pris-wapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: auto;
    padding: 1rem;
    border-radius: 5px 5px 5px 50px;
    align-items: center;
  }

  .ydelser-details-pris {
    color: var(--color-text-light);
  }

  .btn {
    display: block;
    align-items: right;
    background-color: var(--color-CTA);
    padding: 0.75rem 1.5rem;
    border-radius: 5px 50px 5px 50px;
    font-size: 1rem;
  }

.btn a {
color: var(--color-text-light);
text-decoration: none;
font-size: 1rem;
font-weight: 500;
}




/**************** billled *************/
.ydelser-details-billed {
  height: 100%;
}

.ydelser-details-billed img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 5px 50px 5px 5px;
  }

/*********************** mobil verion ***********************/
  @media screen and (max-width: 768px) {
    .ydelser-details-section {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
    }

    .ydelser-details-billed{
        order: -1;
    }
  }
</style>
