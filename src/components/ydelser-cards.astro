---
//@ts-nocheck
import Layout from "../../layouts/layout.astro";
import Ydelser from "../../components/ydelser_details.astro";

const url = `${import.meta.env.PUBLIC_SUPABASE_URL}/rest/v1/anne-louise-hjort?select=*`;
const apiKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;

const response = await fetch(url, {
  headers: {
    apikey: apiKey,
  },
});

const ydelser = await response.json();

console.log(ydelser);
---

<h1>Ydelser og priser</h1>
<section class="grid-cards">
  {
    ydelser.map((ydelse) => (
      <article class="radius-card">
        <h4>{ydelse.titel}</h4>
        <p class="ydelse-info">{ydelse.info}</p>

        <div class="ydelser-details-pris-wapper">
          <div class="pris">
            {ydelse.show_price ? (
              <p>
                {" "}
                <strong>Pris:</strong> {ydelse.tid} minutter pr. session á{" "}
                {ydelse.pris}kr.{" "}
              </p>
            ) : (
              <p>
                {" "}
                <strong>Pris:</strong> aftales individuelt.
              </p>
            )}
          </div>
          <div class="ydelser-details-billed">
            <img src={`/src/assets/ydelser_icon/${ydelse.id}.png`} />
          </div>

          <a href={`/ydelser/${ydelse.slug}`}>
            <button>
              <p>Læs mere</p>
            </button>
          </a>
        </div>
      </article>
    ))
  }
</section>

<style>
  /***************** overskrift ***********************/
  h1 {
    text-align: center;
   
    
  }

  .grid-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    padding: 3rem;
    row-gap: 5rem;
  }

  .radius-card p {
    color: var(--color-text-light);
  }
h4{
   color: var(--color-text-light);
}
  .grid-card {
    background-color: var(--color-section_accent);
    color: var(--color-bg);
    padding: 5px;
    border-radius: 5px;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 769px) {
    .grid-card first-child {
      border-radius: 50px 5px 5px 5px;
    }
    .grid-card:nth-child(4) {
      border-radius: 5px 50px 5px 5px;
    }
    .grid-card:nth-child(5) {
      border-radius: 5px 5px 50px 5px;
    }
    .grid-card last-child {
      border-radius: 5px 5px 5px 50px;
    }
  }
  .radius-card {
    border-radius: 10px 0 0;
    background-color: var(--color-section_accent);
    color: var(--color-bg);
    padding: 5px;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .radius-card1 {
    color: var(--color-text-light);
    padding: 5px;
    border-radius: 0 20px 0 0;
    background-color: var(--color-section_accent);
    color: var(--color-bg);
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .ydelse-info {
    height: 40ch;
    overflow: hidden;
    padding: 0.5rem;
    text-align: l;
  }
  /****************** pris og booking ****************/
  .ydelser-details-pris-wapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: auto;
    padding: 1rem;
    border-radius: 5px 5px 5px 50px;
    align-items: center;
  }

  .pris {
    margin-top: 5px;
    margin-bottom: 1rem;
  }

  button {
    background-color: var(--color-CTA);
    color: var(--color-bg);
    padding: 5px;
    border-radius: 5px;
    border-style: none;
    position: absolute;
    bottom: 0px;
    left: 0;
    width: 100%;
  }
  button:hover{
      background-color: var(--color-Head);
      cursor: pointer;
      transition: background 0.2s ease;
  }
  /*********************** icon ***********************/
  .ydelser-details-billed img {
    margin-left: auto;
    margin-top: auto;
    margin-bottom: 0.1rem;
    margin-right: 0.1rem;
    display: block;
  }

  @media (max-width: 768px) {
    .grid-cards {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .grid-card {
      background-color: var(--color-section_accent);
      color: var(--color-bg);
      padding: 18px;
      border-radius: 5px;
      position: relative;
    }
  }
</style>
