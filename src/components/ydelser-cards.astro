---
//@ts-nocheck
import Layout from "../../layouts/layout.astro";
import Ydelser from "../../components/ydelser_details.astro";

const url = `${import.meta.env.PUBLIC_SUPABASE_URL}/rest/v1/anne-louise-hjort?select=*`;
const apiKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;

const response = await fetch(url, {
  headers: {
    apikey: apiKey,
  },
});

const ydelser = await response.json();

console.log(ydelser);
---

<h1>Ydelser og priser</h1>
  <section class="grid-cards">

{ydelser.map((ydelse) => (
  <article class="radius-card">
    <h4>{ydelse.titel}</h4>
    <p>{ydelse.info}</p>
      <div class="pris">
          {ydelse.show_price ? (
            <p> <strong>Pris:</strong> {ydelse.tid} minutter pr. session á {ydelse.pris}kr. </p>
            ) : (
            <p> <strong>Pris:</strong> aftales individuelt.</p>
            )}
        

            <div class="ydelser-details-billed"><img src={`/src/assets/ydelser_icon/${ydelse.id}.png
              `} /></div>
        </div>
  <a href={`/ydelser/${ydelse.slug}`}>
      <button><p>Læs mere</p></button></a>

 </article>
))}


</section>


  

  <style>
    h1{
        text-align: center;
        padding: 5rem;
    }

.grid-cards{
   display: grid;
   grid-template-columns: repeat(4, 1fr);
   gap:2rem;
   padding: 3rem;
   row-gap: 5rem;
   
   
}

.radius-card p{
  color: var(--color-text-light);
}

.grid-card{
    background-color:var(--color-section_accent);
    color: var(--color-bg);
 padding: 5px;
   border-radius: 5px;
    position: relative;
      display: flex;
    flex-direction: column;
   
   }
.radius-card{
     border-radius: 10px 0 0;
         background-color:var(--color-section_accent);
           color: var(--color-bg);
         padding: 5px;
          position: relative;
           display: flex;
    flex-direction: column;
        
}


.radius-card1{
      color: var(--color-text-light);
         padding: 5px; 
          border-radius: 0 20px 0 0;
          background-color:var(--color-section_accent);
          color: var(--color-bg);
           position: relative;
              display: flex;
    flex-direction: column;
}

button{
    background-color: var(--color-CTA);
color: var(--color-bg);
padding: 5px;
border-radius: 5px;
border-style: none;
position: absolute;
    bottom: -40px;
    left: 0;
    width: 100%;
}
.pris{
  margin-top: 5px;
  margin-bottom: 1rem;

}
.ydelser-details-billed img {
    margin-left: auto;
     margin-top: auto;
    margin-bottom: 0.1rem;
    margin-right: 0.1rem;
    display: block;  
}

@media (max-width: 768px) {
  .grid-cards{
     grid-template-columns: 1fr;
     gap:2rem;
  }
.grid-card{
    background-color:var(--color-section_accent);
    color: var(--color-bg);
 padding: 18px;
   border-radius: 5px;
   }
}



</style>